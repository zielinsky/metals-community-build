{
  "name": "metals-community-build",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code end-to-end tests for Metals against community projects",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "generate:settings": "node scripts/generate-settings.mjs",
    "matrix": "node scripts/create-matrix.mjs",
    "setup:vscode": "node scripts/setup-vscode.mjs",
    "test:e2e": "npm run compile && npm run setup:vscode && npm run test:e2e:prepared",
    "test:e2e:prepared": "npm run generate:settings && node scripts/run-project.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.3.0",
    "mocha": "11.7.5",
    "typescript": "5.9.3",
    "vscode-extension-tester": "8.24.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
