{
  "name": "metals-community-build",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code end-to-end tests for Metals against community projects",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "matrix": "npm run compile --silent && node out/scripts/create-matrix.js",
    "report": "npm run compile --silent && node out/scripts/build-report.js",
    "setup:vscode": "npm run compile --silent && node out/scripts/setup-vscode.js",
    "test:e2e": "npm run compile && node out/scripts/setup-vscode.js && npm run test:e2e:prepared",
    "test:e2e:prepared": "node out/scripts/run-project.js",
    "test:community": "npm run compile --silent && node out/scripts/run-local.js"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.3.0",
    "mocha": "11.7.5",
    "typescript": "5.9.3",
    "vscode-extension-tester": "8.24.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
