{
  "$schema": "https://raw.githubusercontent.com/zielinsky/metals-community-build/main/project.schema.json",
  "id": "rules-scala",
  "name": "Rules Scala",
  "buildTool": "bazel",
  "repository": "bazel-contrib/rules_scala",
  "ref": "master",
  "projectRoot": ".",
  "scenarios": [
    {
      "id": "import-encoded-target-names",
      "kind": "mbt-import",
      "openFile": "test/coverage_filename_encoding/A1.scala",
      "namespaceMode": "each-build-target",
      "required": true,
      "assertions": {
        "minimumNamespaces": 1,
        "sources": [
          "test/coverage_filename_encoding/A1.scala",
          "test/coverage_filename_encoding/Test.scala"
        ]
      }
    },
    {
      "id": "encoded-target-definition",
      "kind": "go-to-definition",
      "openFile": "test/coverage_filename_encoding/Test.scala",
      "symbol": "A1",
      "near": "A1.a1(true)",
      "definition": {
        "file": "test/coverage_filename_encoding/A1.scala",
        "text": "object A1"
      }
    }
  ]
}
