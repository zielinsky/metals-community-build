[metals]       display: flex;
[metals]       flex-wrap: wrap;
[metals]       justify-content: center;
[metals]       gap: 1rem;
[metals]     }
[metals]     .footer-links a {
[metals]       color: var(--secondary-text);
[metals]       text-decoration: none;
[metals]       transition: color 0.3s ease;
[metals]     }
[metals]     .footer-links a:hover {
[metals]       color: var(--primary-color);
[metals]     }
[metals]     @media (max-width: 640px) {
