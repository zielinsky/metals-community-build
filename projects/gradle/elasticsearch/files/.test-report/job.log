[metals]       gap: 1rem;
[metals]       justify-content: center;
[metals]       flex-wrap: wrap;
[metals]     }
[metals]     .links a {
[metals]       font-weight: 700;
[metals]       text-decoration: none;
[metals]       padding: 0.75rem 1.5rem;
[metals]       border-radius: 50px;
[metals]       font-size: 1rem;
[metals]       position: relative;
[metals]     }
[metals]     .links a.secondary {
[metals]       color: var(--primary-dark);
[metals]     }
[metals]     .links a.secondary::after {
[metals]       content: "→";
[metals]       color: var(--primary-dark);
[metals]       position: absolute;
[metals]       right: 0;
[metals]       top: 50%;
[metals]       transform: translateY(-50%);
[metals]       font-weight: bold;
[metals]     }
[metals]     .links a.primary {
[metals]       background: linear-gradient(180deg, var(--primary-dark) 0%, var(--primary-dark) 100%);
[metals]       color: white;
[metals]     }
[metals]     .links a.primary:hover {
[metals]       background: var(--primary-gradient);
[metals]     }
[metals]     footer {
