[metals]     .actions {
[metals]       list-style: none;
[metals]       padding: 0;
[metals]       margin: 2rem 0;
[metals]       text-align: left;
[metals]     }
[metals]     .actions li {
[metals]       margin: 0.75rem 0;
[metals]       padding-left: 1.75rem;
[metals]       position: relative;
[metals]     }
[metals]     .actions li::before {
[metals]       content: "→";
[metals]       color: var(--primary-color);
[metals]       position: absolute;
[metals]       left: 0;
[metals]       font-weight: bold;
[metals]     }
[metals]     .links {
[metals]       margin-top: 2.5rem;
[metals]       display: flex;
[metals]       gap: 1rem;
[metals]       justify-content: center;
[metals]       flex-wrap: wrap;
[metals]     }
[metals]     .links a {
[metals]       font-weight: 700;
[metals]       text-decoration: none;
[metals]       padding: 0.75rem 1.5rem;
[metals]       border-radius: 50px;
[metals]       font-size: 1rem;
[metals]       position: relative;
[metals]     }
[metals]     .links a.secondary {
[metals]       color: var(--primary-dark);
[metals]     }
[metals]     .links a.secondary::after {
[metals]       content: "→";
[metals]       color: var(--primary-dark);
[metals]       position: absolute;
[metals]       right: 0;
[metals]       top: 50%;
[metals]       transform: translateY(-50%);
[metals]       font-weight: bold;
[metals]     }
[metals]     .links a.primary {
[metals]       background: linear-gradient(180deg, var(--primary-dark) 0%, var(--primary-dark) 100%);
[metals]       color: white;
[metals]     }
[metals]     .links a.primary:hover {
[metals]       background: var(--primary-gradient);
[metals]     }
[metals]     footer {
[metals]       background: white;
[metals]       border-top: 1px solid var(--border-color);
[metals]       padding: 1.5rem;
[metals]       font-size: 0.875rem;
[metals]       color: var(--secondary-text);
[metals]       text-align: center;
[metals]     }
[metals]     .footer-links {
[metals]       margin-top: 1rem;
[metals]       display: flex;
[metals]       flex-wrap: wrap;
[metals]       justify-content: center;
[metals]       gap: 1rem;
[metals]     }
[metals]     .footer-links a {
[metals]       color: var(--secondary-text);
[metals]       text-decoration: none;
[metals]       transition: color 0.3s ease;
[metals]     }
[metals]     .footer-links a:hover {
[metals]       color: var(--primary-color);
[metals]     }
[metals]     @media (max-width: 640px) {
[metals]       main {
[metals]         padding: 1rem;
[metals]       }
[metals]       html {
[metals]         font-size: 14px;
[metals]       }
[metals]       .links a.secondary::after {
[metals]         display: none;
[metals]       }
[metals]       .logo {
[metals]         width: 140px;
[metals]       }
[metals]       .links a {
[metals]         padding: 0.2rem 1rem;
[metals]       }
[metals]     }
[metals]   </style>
[metals] </head>
