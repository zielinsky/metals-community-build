  @new Test() def testCreateDelegationTokenWithSmallerTimeout(): Unit = {
    client = createAdminClient;
    val timeout = 5000;
    val options = new CreateDelegationTokenOptions().maxLifetimeMs(timeout);
    val tokenInfo = client.createDelegationToken(options).delegationToken.get.tokenInfo;
    assertEquals(timeout, tokenInfo.maxTimestamp.$minus(tokenInfo.issueTimestamp));
    assertTrue(tokenInfo.maxTimestamp.$greater$eq(tokenInfo.expiryTimestamp))
