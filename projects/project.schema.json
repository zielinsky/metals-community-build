{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "buildTool", "repository", "ref", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "buildTool": { "enum": ["bazel", "maven", "gradle"] },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "ref": { "type": "string", "minLength": 1 },
    "projectRoot": { "type": "string", "default": "." },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "openFile", "assertions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "const": "mbt-import" },
          "openFile": { "type": "string", "minLength": 1 },
          "namespaceMode": {
            "enum": ["each-build-target", "single-global-target"]
          },
          "assertions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimumNamespaces": { "type": "integer", "minimum": 1 },
              "minimumDependencyModules": { "type": "integer", "minimum": 0 },
              "sources": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
