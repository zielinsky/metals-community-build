{
  "$schema": "https://raw.githubusercontent.com/zielinsky/metals-community-build/main/project.schema.json",
  "id": "turbine",
  "name": "Turbine",
  "buildTool": "maven",
  "repository": "google/turbine",
  "ref": "main",
  "projectRoot": ".",
  "scenarios": [
    {
      "id": "import",
      "kind": "mbt-import",
      "openFile": "java/com/google/turbine/main/Main.java",
      "required": true,
      "assertions": {
        "minimumNamespaces": 1,
        "sources": [
          "java/com/google/turbine/main/Main.java"
        ],
        "dependencies": [
          "com.google.guava:guava"
        ]
      }
    },
    {
      "id": "rename-manifest-dir",
      "kind": "rename-symbol",
      "openFile": "java/com/google/turbine/main/Main.java",
      "rename": {
        "symbol": "MANIFEST_DIR",
        "newName": "MANIFEST_DIRECTORY",
        "expectedOccurrences": 2
      }
    },
    {
      "id": "turbine-options-hover",
      "kind": "hover",
      "openFile": "java/com/google/turbine/main/Main.java",
      "symbol": "TurbineOptions",
      "hoverText": "Header compilation options."
    },
    {
      "id": "turbine-options-definition",
      "kind": "go-to-definition",
      "openFile": "java/com/google/turbine/main/Main.java",
      "symbol": "TurbineOptions",
      "definition": {
        "file": "java/com/google/turbine/options/TurbineOptions.java",
        "text": "TurbineOptions"
      }
    },
    {
      "id": "jdk-symbol-references",
      "kind": "find-references",
      "openFile": "java/com/google/turbine/main/Main.java",
      "symbol": "Objects",
      "near": "import static java.util.Objects.requireNonNull;",
      "references": {
        "minimumCount": 2,
        "files": [
          "java/com/google/turbine/options/TurbineOptions.java"
        ]
      }
    },
    {
      "id": "local-variable-highlight",
      "kind": "document-highlight",
      "openFile": "java/com/google/turbine/main/Main.java",
      "symbol": "ok",
      "near": "boolean ok;",
      "highlight": {
        "expectedOccurrences": 6
      }
    },
    {
      "id": "import-missing-symbol",
      "kind": "code-action",
      "openFile": "java/com/google/turbine/main/Main.java",
      "symbol": "Objects",
      "near": "BUFFER_SIZE = Objects.hash",
      "codeAction": {
        "edit": {
          "replace": "private static final int BUFFER_SIZE = 65536;",
          "with": "private static final int BUFFER_SIZE = Objects.hash(65536);"
        },
        "menu": "quick-fix",
        "title": "Import 'Objects' from package 'java.util'",
        "expectedText": "import java.util.Objects;"
      }
    }
  ]
}
